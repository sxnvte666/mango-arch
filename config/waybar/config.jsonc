{
  "layer": "top",
  "position": "top",
  "modules-left": ["mango/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio", "custom/sep" ,"tray"],
  // "margin-bottom": 10,
  // "width": 1000,
  "mango/workspaces": {
      "format": "{icon}",
      "hide-empty": false,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "overview",
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}",
    "on-click-right": "thunderbird",
    "on-click": "",
    "tooltip-format": "{:%d-%m-%Y}",
  },
  "pulseaudio": {
    "format": "{volume}% vol ",
    "format-bluetooth": "{volume}% bvol ",
    "format-muted": "muted ",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "󰓃",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "󰂑",
      "headset": "󰂑",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    "scroll-step": 1,
    "on-click": "foot --app-id wiremix wiremix",
    "on-click-right": "pamixer -t",
  },
  "disk": {
    "interval": 30,
    "format": "{percentage_free}% free on {path}",
  },
  "custom/sep": {
    "format": "| ",
    "interval": 0
  },
  "tray": {
     "icon-size": 21,
  },
}
