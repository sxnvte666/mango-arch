{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/cat.txt",
        "color": {
            "1": "#9FD88A",
            "2": "#E0B15E",
            "3": "#DB8267",
            "4": "#626F51"
        },
        "padding": {
            "top": 2,
            "left": 2
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "custom",
            "format": "  \u001b[38;2;98;111;81m~ purr-fectly configured ~\u001b[0m"
        },
        "break",
        {
            "type": "custom",
            "format": "  \u001b[38;2;159;216;138m\u001b[1m◆ hardware\u001b[0m \u001b[38;2;57;65;42m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
        },
        {
            "type": "host",
            "key": "  󰌢  ",
            "keyColor": "#9FD88A"
        },
        {
            "type": "cpu",
            "key": "  󰻠  ",
            "keyColor": "#9FD88A"
        },
        {
            "type": "gpu",
            "key": "  󰍹  ",
            "keyColor": "#9FD88A"
        },
        {
            "type": "memory",
            "key": "  󰑭  ",
            "keyColor": "#9FD88A"
        },
        {
            "type": "disk",
            "key": "  󰋊  ",
            "keyColor": "#9FD88A"
        },
        "break",
        {
            "type": "custom",
            "format": "  \u001b[38;2;224;177;94m\u001b[1m◆ software\u001b[0m \u001b[38;2;57;65;42m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
        },
        {
            "type": "os",
            "key": "    ",
            "keyColor": "#E0B15E"
        },
        {
            "type": "kernel",
            "key": "  󰌽  ",
            "keyColor": "#E0B15E"
        },
        {
            "type": "bios",
            "key": "  󰖡  ",
            "keyColor": "#E0B15E"
        },
        {
            "type": "packages",
            "key": "  󰏗  ",
            "keyColor": "#E0B15E"
        },
        {
            "type": "shell",
            "key": "  󰞷  ",
            "keyColor": "#E0B15E"
        },
        "break",
        {
            "type": "custom",
            "format": "  \u001b[38;2;125;163;179m\u001b[1m◆ desktop\u001b[0m \u001b[38;2;57;65;42m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
        },
        {
            "type": "de",
            "key": "  󰧨  ",
            "keyColor": "#7DA3B3"
        },
        {
            "type": "wm",
            "key": "  󱂬  ",
            "keyColor": "#7DA3B3"
        },
        {
            "type": "wmtheme",
            "key": "  󰉦  ",
            "keyColor": "#7DA3B3"
        },
        {
            "type": "terminal",
            "key": "  󰆍  ",
            "keyColor": "#7DA3B3"
        },
        "break",
        {
            "type": "custom",
            "format": "  \u001b[38;2;172;142;208m\u001b[1m◆ naps & days\u001b[0m \u001b[38;2;57;65;42m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
        },
        {
            "type": "command",
            "key": "  󰃭  ",
            "keyColor": "#AC8ED0",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "  󰅐  ",
            "keyColor": "#AC8ED0"
        },
        {
            "type": "datetime",
            "key": "  󰥔  ",
            "keyColor": "#AC8ED0"
        },
        {
            "type": "custom",
            "format": "  \u001b[38;2;57;65;42m╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌╌\u001b[0m"
        },
        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "block"
        }
    ]
}
