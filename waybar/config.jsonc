{
  "layer": "top",
  "position": "top",
  "modules-left": ["mango/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["pulseaudio"],
  // "margin-bottom": 10,
  // "width": 1000,
  "mango/workspaces": {
      "format": "{icon}",
      "hide-empty": true,
      "on-click": "activate",
      "on-click-right": "toggle",
      "overview-label": "OVERVIEW",
  },
  "clock": {
    "format-alt": "{:%a, %d. %b  %H:%M}",
  },
  "pulseaudio": {
    "format": "{volume}% vol ",
    "format-bluetooth": "{volume}% {icon}",
    "format-muted": "muted ",
    "format-icons": {
      "alsa_output.pci-0000_00_1f.3.analog-stereo": "󰓃",
      "alsa_output.pci-0000_00_1f.3.analog-stereo-muted": "",
      "headphone": "",
      "hands-free": "󰂑",
      "headset": "󰂑",
      "phone": "",
      "phone-muted": "",
      "portable": "",
      "car": "",
      "default": ["", ""],
    },
    "scroll-step": 1,
    "on-click": "pavucontrol",
    "on-click-right": "pamixer -t",
  },
  "disk": {
    "interval": 30,
    "format": "{percentage_free}% free on {path}",
  },
  "custom/separator": {
    "format": "|",
    "interval": 0
  },
}

